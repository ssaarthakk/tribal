{
  "mcpServers": {
    "falkordb": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@falkordb/mcpserver@1.3.0"],
      "env": {
        "FALKORDB_HOST": "127.0.0.1",
        "FALKORDB_PORT": "${FALKORDB_DEV_PORT:-6390}",
        "FALKORDB_DEFAULT_READONLY": "true"
      }
    }
  }
}
